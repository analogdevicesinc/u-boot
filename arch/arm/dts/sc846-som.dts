/dts-v1/;

#include "sc846.dtsi"

/ {
	model = "ADI SC846-SOM";
	compatible = "adi,sc846-som", "adi,sc846-64";

	aliases {
		spi0 = "/ospi";
		spi1 = "/spi1";
	};
};

&rcu {
	status = "okay";
};

&sharcfx {
	status = "okay";
};

&uart0 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
};

&wdog {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
	secid = <235>;
	status = "okay";
};

&i2c0 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
};

&i2c1 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
};

&i2c2 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
};

&i2c3 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
};

&i2c4 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
};

&i2c5 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
	status = "okay";

	gpio_expander1: adp5587@34 {
		compatible = "adi,adp5587";
		reg = <0x34>;
		gpio-controller;
		#gpio-cells = <2>;
		bootph-pre-ram;

		uart0-flow {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "uart0-flow-en";
			bootph-pre-ram;
		};

		uart0 {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "uart0-en";
			bootph-pre-ram;
		};

		sd-card {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "sd-card-en";
		};

		usb-phy {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "usb-phy-reset";
		};

		led-ds4 {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds4";
			bootph-pre-ram;
		};

		led-ds3 {
			gpio-hog;
			gpios = <16 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds3";
		};

		led-ds2 {
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "led-ds2";
		};
	};
};

&spi1 {
	clocks = <&clk ADSP_SC846_CLK_SPI>;

	flash1: is25wp02gg@1 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor", "is25wp02gg";
		reg = <1>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <50000000>;
		bootph-pre-ram;
	};
};

&timer0 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
};
