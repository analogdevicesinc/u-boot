/dts-v1/;

/ {
	model = "Alif Ensemble DevKit-E8";
	compatible = "alif,ensemble-devkit-e8", "alif,ensemble";
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		serial0 = &uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootph-all;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			compatible = "arm,cortex-a32";
			device_type = "cpu";
			reg = <0>;
			enable-method = "psci";
		};

		cpu@1 {
			compatible = "arm,cortex-a32";
			device_type = "cpu";
			reg = <1>;
			enable-method = "psci";
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
		bootph-all;
	};

	/*
	 * SRAM0 and SRAM1 are stitched. The top 0x23000 bytes are used by IPC
	 * shared memory, TF-A and the MHU services.
	 */
	memory@2000000 {
		device_type = "memory";
		reg = <0x02000000 0x7dd000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		bootph-all;

		eth0: ethernet@48100000 {
			compatible = "alif,ensemble-eqos";
			reg = <0x48100000 0x2000>;
			phy-mode = "rmii";
			phy-handle = <&phy0>;
			max-speed = <100>;

			mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;

				phy0: ethernet-phy@1 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <1>;
				};
			};
		};

		uart2: serial@4901a000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x4901a000 0x1000>;
			clock-frequency = <100000000>;
			reg-shift = <2>;
			reg-io-width = <4>;
			bootph-all;
		};
	};
};
