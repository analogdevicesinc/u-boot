/dts-v1/;

#include "sc846-som.dts"

/ {
	model = "ADI SC846-SOMCRR2-EZKIT";
	compatible = "adi,sc846-som-ezkit", "adi,sc846-64";
};

&i2c2 {
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
	status = "okay";

	crr_gpio_expander: adp5587@30 {
		compatible = "adi,adp5587";
		reg = <0x30>;
		gpio-controller;
		#gpio-cells = <2>;
		bootph-pre-ram;

		eth0-reset {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "eth0-reset";
		};

		spdif1-en {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "spdif1-en";
		};

		adau1966-reset-som-a {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "adau1966-reset-som-a";
		};

		adau1979-a-reset-som-a {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "adau1979-a-reset-som-a";
		};

		adau1979-b-reset-som-a {
			gpio-hog;
			gpios = <4 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "adau1979-b-reset-som-a";
		};

		pushbutton-b-en {
			gpio-hog;
			gpios = <5 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "pushbutton-b-en";
		};

		spdif1-opt-en {
			gpio-hog;
			gpios = <6 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "spdif1-opt-en";
		};

		spdif1-coax-en {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "spdif1-coax-en";
		};

		adc1-route {
			gpio-hog;
			gpios = <8 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "adc1-route";
		};

		adc2-route {
			gpio-hog;
			gpios = <9 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "adc2-route";
		};

		dac-route {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "dac-route";
		};

		dai1-route {
			gpio-hog;
			gpios = <11 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "dai1-route";
		};

		qspi-route {
			gpio-hog;
			gpios = <12 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "qspi-route";
		};

		a2b1-io1 {
			gpio-hog;
			gpios = <13 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b1-io1";
		};

		a2b1-io2 {
			gpio-hog;
			gpios = <14 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b1-io2";
		};

		a2b1-io7 {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b1-io7";
		};

		a2b2-io1 {
			gpio-hog;
			gpios = <16 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b2-io1";
		};

		a2b2-io2 {
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "a2b2-io2";
		};
	};
};

&eth0 {
	compatible = "adi,sc59x-dwmac-eqos";
	phy-handle = <&adin1300>;
	phy-mode = "rgmii-id";
	clocks = <&clk ADSP_SC846_CLK_CGU0_SCLK0>;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		adin1300: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};
	};
};
