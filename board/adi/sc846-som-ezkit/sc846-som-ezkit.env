board_bootargs=cma=64M coherent_pool=32M clk_ignore_unused

fdt_addr_r=CONFIG_SYS_LOAD_ADDR
kernel_addr_r=0x9a200000
ramdisk_addr_r=0x9c000000

#define USE_NFS
#define USE_SPI
#define USE_OSPI
#define USE_RAM
#define USE_MMC

#include <env/adi/adi_boot.env>
